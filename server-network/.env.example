NODE_ENV=development
PORT=60112
DATABASE_URL=mysql://user:password@localhost:3306/network_manager
JWT_SECRET=CHANGE_ME
AGENT_REGISTRATION_TOKEN=CHANGE_ME
LOG_LEVEL=info
WEB_PORT=3200
WEB_PUBLIC_URL=http://localhost:3200

# ---- Optional (defaults shown) ----
# HOST=0.0.0.0
# Admin access-token / session lifetime in seconds
# JWT_TTL_SECONDS=86400   # admin session length (password or login-link sign-in); 60..86400, default 1 day
# Fastify trustProxy: true | false | hop count | comma-separated CIDRs/IPs of your reverse proxy
# TRUST_PROXY=false
# Native HTTPS (otherwise run plain HTTP behind a TLS-terminating reverse proxy)
# TLS_CERT_PATH=/etc/server-network/tls/fullchain.pem
# TLS_KEY_PATH=/etc/server-network/tls/privkey.pem
# Comma-separated allowed browser origins for the admin API (CORS disabled when empty)
# CORS_ORIGIN=
# Heartbeat interval returned to agents
# HEARTBEAT_INTERVAL_SECONDS=60
# Comma-separated management hostnames; the policy validator warns when a pattern would match one
# MANAGEMENT_HOSTNAMES=management.example.com
# Device credential lifetime in days (0 = no expiry, expires_at: null)
# DEVICE_CREDENTIAL_TTL_DAYS=0
# Failed logins before temporary lockout (0 disables) and lockout duration
# LOGIN_LOCKOUT_THRESHOLD=10
# LOGIN_LOCKOUT_MINUTES=15
# Admin console (web/): public URL linked from GET / on the API, console port, and the API URL the
# console proxies /api/* to (defaults: http://localhost:3001, 3001, http://localhost:$PORT).
# WEB_PORT is read from the shell environment; API_URL/PORT are also picked up from this file.
# WEB_PUBLIC_URL=http://localhost:3001
# WEB_PORT=3001
# API_URL=http://localhost:60112
# Seed passwords (random ones are generated and printed once if unset)
# SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
# SEED_SUPER_ADMIN_PASSWORD=
# SEED_ORG_ADMIN_PASSWORD=
# Integration tests: a DISPOSABLE database (it is wiped)
# TEST_DATABASE_URL=mysql://nam_test:password@localhost:3306/network_manager_test
