{
  "name": "server-network",
  "version": "1.0.0",
  "private": true,
  "description": "Central Network Access Management server (policy authority)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "tsx scripts/next-web.ts dev",
    "start": "concurrently -k -n api,web -c blue,magenta \"npm:start:api\" \"npm:start:web\"",
    "start:api": "node dist/src/server.js",
    "start:web": "tsx scripts/next-web.ts start",
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p tsconfig.build.json",
    "build:web": "next build web",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "test:vector": "tsx scripts/print-test-vector.ts",
    "suadmin__reset_password": "tsx scripts/reset-password.ts",
    "predev": "tsx scripts/dev-sync-admin.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.104.0",
    "concurrently": "^9.2.4",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "next": "^15.5.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
