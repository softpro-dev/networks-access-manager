#!/bin/bash
# SoftProIt Network Service .pkg — runs as root after the payload is in
# /usr/local/softproit/SoftProIt.network.conducted/. Asks nothing:
#
# 1. Creates the root-only data root (/Library/Application Support/OrganizationNetworkAgent).
# 2. Writes agent.env from config.env, baked in at build time from os-apps/.env
#    (ADMIN_SERVER, ACCESS_TOKE, CACHE_EXPIRATION_TIME_IN_MINUTE). Every install/upgrade
#    rewrites it, like the Windows installer.
# 3. Registers and starts the LaunchDaemon (com.softproit.network.conducted).
#
# Details go to /var/log/softproit-network-install.log.

APP=/usr/local/softproit/SoftProIt.network.conducted/SoftProIt.network.conducted
DATA="/Library/Application Support/OrganizationNetworkAgent"
ENV_FILE="$DATA/config/agent.env"
LOG=/var/log/softproit-network-install.log
exec >>"$LOG" 2>&1
echo "=== $(date) postinstall"

mkdir -p "$DATA/config" "$DATA/data" "$DATA/logs"
chown -R root:wheel "$DATA"
chmod -R go-rwx "$DATA"

CFG_SERVER="" CFG_TOKEN="" CFG_CACHE=5
# shellcheck source=/dev/null
[ -f "$(dirname "$0")/config.env" ] && . "$(dirname "$0")/config.env"
if [ -z "$CFG_SERVER" ] || [ -z "$CFG_TOKEN" ]; then
  echo "package was built without ADMIN_SERVER/ACCESS_TOKE; not configured"
  exit 1   # Installer reports the failure instead of leaving an unconfigured daemon
fi

umask 077
{
  echo "# Managed by SoftProIt Network Service setup (org-token mode)."
  echo "ADMIN_SERVER=\"$CFG_SERVER\""
  echo "ACCESS_TOKE=\"$CFG_TOKEN\""
  echo "CACHE_EXPIRATION_TIME_IN_MINUTE=\"$CFG_CACHE\""
  echo "NAM_SECRET_PROTECTOR=\"file-key\""
  case "$CFG_SERVER" in https://*) ;; *) echo "NAM_ALLOW_INSECURE_HTTP=\"true\"" ;; esac
} > "$ENV_FILE"
chown root:wheel "$ENV_FILE"
chmod 600 "$ENV_FILE"
echo "wrote $ENV_FILE (server $CFG_SERVER, refresh $CFG_CACHE min)"

"$APP" uninstall || true
if ! "$APP" install; then
  echo "daemon registration failed"
  exit 1
fi
"$APP" start || echo "start did not report RUNNING; see $DATA/logs"
exit 0
