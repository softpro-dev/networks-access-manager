BUILD_VERSION=1.0
CODE_NUMBER=BRANCH-003
CACHE_EXPIRATION_TIME_IN_MINUTE=5
ADMIN_SERVER=http://localhost:3001
ACCESS_TOKE=organization_token
# Required for the Service installer: stopping or uninstalling the service asks for it.
# Only a salted hash is stored in the installer and on the computers.
UNINSTALL_PASSWORD=change_me

 
# TESTING ONLY: poll every N seconds (5-3600) instead of CACHE_EXPIRATION_TIME_IN_MINUTE.
# Leave empty for real deployments; setup shows a "TEST BUILD" notice when it is set.
NAM_TEST_POLL_SECONDS=
