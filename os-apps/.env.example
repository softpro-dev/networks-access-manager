# SoftProIt network agent configuration.
#
# ------------------------------------------------------------------------------
# Org-token (unattended) mode — the documented default for mass deployment.
# ------------------------------------------------------------------------------
# ADMIN_SERVER is the management/admin server base URL. The API base is derived as
# ${ADMIN_SERVER}/api (the admin console proxies /api to the API; in production
# ADMIN_SERVER is the public URL). Override the suffix with NAM_API_BASE_SUFFIX, or
# set API_BASE_URL to override the derivation entirely.
ADMIN_SERVER=http://localhost:3001
# ACCESS_TOKE selects org-token mode when present. Copy it from the admin console:
# organization -> Generate access token (format nat_<43 chars>, non-expiring).
ACCESS_TOKE=copy_from_organization_list
# How often (minutes) to re-fetch the org policy. The cached policy never expires;
# this is only the poll cadence.
CACHE_EXPIRATION_TIME_IN_MINUTE=5

# ------------------------------------------------------------------------------
# Per-device enrollment mode (used only when ACCESS_TOKE is absent). Kept for
# backward compatibility.
# ------------------------------------------------------------------------------
#ORGANIZATION_ID=INST-001
#API_BASE_URL=https://management.example.com/api
#DEVICE_REGISTRATION_TOKEN=CHANGE_ME
#POLICY_CACHE_TTL=300
#HEARTBEAT_INTERVAL=60

# ------------------------------------------------------------------------------
# Common options.
# ------------------------------------------------------------------------------
#LOG_LEVEL=INFO
#VERIFY_TLS=true
# Secret protector at rest: dpapi (Windows), file-key (macOS/POSIX), insecure-dev (tests).
#NAM_SECRET_PROTECTOR=dpapi
# Allow http:// (development only; production must use https).
#NAM_ALLOW_INSECURE_HTTP=false

# ------------------------------------------------------------------------------
# Build only (scripts\build.ps1, build-now\build-*-setup.bat). Not read by the service.
# ------------------------------------------------------------------------------
BUILD_VERSION=1.0.0
